# Required
DATABASE_URL=
SESSION_KEY=

# Mail. MAIL_TRANSPORT empty or "smtp" reads the SMTP variables: leave
# SMTP_TLS empty or "off" for the local Mailpit, "starttls" for a relay on the
# network, which also needs the login. MAIL_TRANSPORT="brevo-api" sends over
# HTTPS with BREVO_API_KEY and ignores the SMTP variables; use it on a host
# that blocks outbound SMTP ports, as a free Render web service does.
MAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=
SMTP_USERNAME=
SMTP_PASSWORD=
BREVO_API_KEY=
MAIL_FROM=
APP_BASE_URL=

# Cookie. "true" once the application is served over HTTPS; the server refuses
# to start with an https:// APP_BASE_URL and anything else.
COOKIE_SECURE=

# Network gate. attempts/seconds per client address; the defaults are shown.
# RATE_LIMIT_ACCOUNT covers registration, resend, and reset request (the
# routes that send mail); RATE_LIMIT_LOGIN covers login, verify, and reset.
# CLIENT_ADDRESS_SOURCE is peer, or forwarded-for behind a platform proxy.
RATE_LIMIT_ACCOUNT=5/3600
RATE_LIMIT_LOGIN=10/300
CLIENT_ADDRESS_SOURCE=peer

# Pilot notice. "true" shows the one-line study-copy notice on every page.
PILOT_NOTICE=

# Container only. PORT overrides the port in LEPTOS_SITE_ADDR when a host sets it.
# LEPTOS_SITE_ADDR=0.0.0.0:3000
# PORT=
