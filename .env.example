# Required
DATABASE_URL=
SESSION_KEY=

# Mail. Leave SMTP_TLS empty or "off" for the local Mailpit; "starttls" for a
# relay on the network, which also needs the login below.
SMTP_HOST=
SMTP_PORT=
SMTP_TLS=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
APP_BASE_URL=

# Cookie. "true" once the application is served over HTTPS.
COOKIE_SECURE=

# Container only. PORT overrides the port in LEPTOS_SITE_ADDR when a host sets it.
# LEPTOS_SITE_ADDR=0.0.0.0:3000
# PORT=
